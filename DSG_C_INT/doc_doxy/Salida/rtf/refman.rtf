00134 {\cf18 void} generate_waveform() \{\par
00135     {\cf17 static} uint64_t last_time = 0;\par
00136     uint64_t current_time = time_us_64();\par
00137     {\cf18 float} value = 0;\par
00138 \par
00139     {\cf20 // Calcular el paso de tiempo}\par
00140     {\cf18 float} time_step = (current_time - last_time) / 1000000.0f;\par
00141     last_time = current_time;\par
00142 \par
00143     {\cf19 switch} (current_waveform) \{\par
00144         {\cf19 case} SINE:\par
00145             value = amplitude * (sinf(2 * M_PI * frequency * time_step) / 2 + 0.5) + dc_offset;\par
00146             {\cf19 break};\par
00147         {\cf19 case} SQUARE:\par
00148             value = amplitude * (sinf(2 * M_PI * frequency * time_step) > 0 ? 1 : -1) / 2 + 0.5 + dc_offset;\par
00149             {\cf19 break};\par
00150         {\cf19 case} SAWTOOTH:\par
00151             value = amplitude * (2 * fmod(frequency * time_step, 1) - 1) / 2 + 0.5 + dc_offset;\par
00152             {\cf19 break};\par
00153         {\cf19 case} TRIANGULAR:\par
00154             value = amplitude * (1.0 - fabs(fmod(frequency * time_step * 4, 4) - 2)) + dc_offset;\par
00155             {\cf19 break};\par
00156     \}\par
00157 \par
00158     {\cf20 // Convertir a valor DAC}\par
00159     uint dac_value = (uint)((value / VREF) * DAC_MAX_VALUE);\par
00160     gpio_put(DAC_PIN, dac_value);  {\cf20 // Suponiendo que DAC_PIN est\'C3\'A1 conectado a un DAC de escalera R2R simple o similar}\par
00161 \}\par
00162 \par
00166 {\cf18 void} gpio_callback(uint gpio, uint32_t events) \{\par
00167     {\cf17 static} uint64_t last_interrupt_time = 0;\par
00168     uint64_t current_time = to_ms_since_boot(get_absolute_time());\par
00169 \par
00170     {\cf19 if} (current_time - last_interrupt_time > DEBOUNCE_MS) \{\par
00171         last_interrupt_time = current_time;\par
00172 \par
00173         {\cf19 if} (gpio == WAVEFORM_BUTTON_PIN) \{\par
00174             current_waveform = (Waveform)((current_waveform + 1) % 4);\par
00175             printf({\cf22 "Forma de onda cambiada a %d\\n"}, current_waveform);\par
00176         \} {\cf19 else} \{\par
00177             {\cf19 for} ({\cf18 int} row = 0; row < ROWS; ++row) \{\par
00178                 gpio_put(rowPins[row], 0);  {\cf20 // Activar la fila}\par
00179                 {\cf19 for} ({\cf18 int} col = 0; col < COLS; ++col) \{\par
00180                     {\cf19 if} (!gpio_get(colPins[col])) \{\par
00181                         {\cf18 char} key = keys[row][col];\par
00182                         printf({\cf22 "Tecla presionada: %c\\n"}, key);\par
00183                         handle_input(key);\par
00184                     \}\par
00185                 \}\par
00186                 gpio_put(rowPins[row], 1);  {\cf20 // Desactivar la fila}\par
00187             \}\par
00188         \}\par
00189     \}\par
00190 \}\par
00191 \par
00195 {\cf18 void} handle_input({\cf18 char} key) \{\par
00196     {\cf19 if} (key == {\cf23 'D'}) \{\par
00197         {\cf19 if} (paramType == {\cf23 'A'}) \{\par
00198             amplitude = strtof(inputBuffer, NULL);\par
00199             printf({\cf22 "Amplitud establecida en: %.2f mV\\n"}, amplitude);\par
00200         \} {\cf19 else} {\cf19 if} (paramType == {\cf23 'B'}) \{\par
00201             frequency = strtof(inputBuffer,NULL);\par
00202             printf({\cf22 "Frecuencia establecida en: %.2f Hz\\n"}, frequency);\par
00203         \} {\cf19 else} {\cf19 if} (paramType == {\cf23 'C'}) \{\par
00204             dc_offset = strtof(inputBuffer,NULL);\par
00205             printf({\cf22 "Desplazamiento DC establecido en: %.2f mV\\n"}, dc_offset);\par
00206         \}\par
00207         inputIndex = 0;\par
00208         memset(inputBuffer, 0, {\cf17 sizeof}(inputBuffer));\par
00209     \} {\cf19 else} \{\par
00210         {\cf19 if} (key == {\cf23 'A'} || key == {\cf23 'B'} || key == {\cf23 'C'}) \{\par
00211             paramType = key;\par
00212         \} {\cf19 else} {\cf19 if} (isdigit(key)) \{\par
00213             {\cf19 if} (inputIndex < {\cf17 sizeof}(inputBuffer) - 1) \{\par
00214                 inputBuffer[inputIndex++] = key;\par
00215             \}\par
00216         \}\par
00217     \}\par
00218 \}\par
