00106 {\cf18 void} setup_gpio() \{\par
00107     {\cf20 // Configuraci\'C3\'B3n para el DAC y el bot\'C3\'B3n de forma de onda}\par
00108     gpio_init(DAC_PIN);\par
00109     gpio_set_dir(DAC_PIN, GPIO_OUT);\par
00110 \par
00111     gpio_init(WAVEFORM_BUTTON_PIN);\par
00112     gpio_set_dir(WAVEFORM_BUTTON_PIN, GPIO_IN);\par
00113     gpio_pull_up(WAVEFORM_BUTTON_PIN);\par
00114     gpio_set_irq_enabled_with_callback(WAVEFORM_BUTTON_PIN, GPIO_IRQ_EDGE_FALL, {\cf17 true}, &gpio_callback);\par
00115 \par
00116     {\cf20 // Configuraci\'C3\'B3n para el teclado}\par
00117     {\cf19 for} ({\cf18 int} i = 0; i < ROWS; i++) \{\par
00118         gpio_init(rowPins[i]);\par
00119         gpio_set_dir(rowPins[i], GPIO_OUT);\par
00120         gpio_put(rowPins[i], 1);\par
00121     \}\par
00122 \par
00123     {\cf19 for} ({\cf18 int} i = 0; i < COLS; i++) \{\par
00124         gpio_init(colPins[i]);\par
00125         gpio_set_dir(colPins[i], GPIO_IN);\par
00126         gpio_pull_up(colPins[i]);\par
00127         gpio_set_irq_enabled_with_callback(colPins[i], GPIO_IRQ_EDGE_FALL, {\cf17 true}, &gpio_callback);\par
00128     \}\par
00129 \}\par
